APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://api.app.nought.one
FRONTEND_URL=https://app.nought.one
FORCE_PUBLIC_URL=true
# Trust the Railway edge only when direct ingress is restricted to that edge/private network.
TRUSTED_PROXIES=*
PORT=8080
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=${{Postgres.PGHOST}}
DB_PORT=${{Postgres.PGPORT}}
DB_DATABASE=${{Postgres.PGDATABASE}}
DB_USERNAME=${{Postgres.PGUSER}}
DB_PASSWORD=${{Postgres.PGPASSWORD}}
DB_SSLMODE=require
SESSION_DRIVER=database
SESSION_DOMAIN=.app.nought.one
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=app.nought.one
CORS_ALLOWED_ORIGINS=https://app.nought.one
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=120
CARD_ASSETS_DISK=card_assets_s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Configure a real mail transport before public launch. Never log reset links in production.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=nought.one
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=90
