# Laravel API origin, used by the server and browser authentication.
# Must be browser-reachable; use the same hostname as the frontend locally.
API_BASE_URL=http://localhost:8000
# Website origin used for canonical links, vCards, and QR codes.
PUBLIC_SITE_URL=http://localhost:3000
# For phone testing, configure reachable origins and Laravel APP_URL consistently.

# Laravel must allow PUBLIC_SITE_URL in CORS_ALLOWED_ORIGINS and its host:port
# in SANCTUM_STATEFUL_DOMAINS. Subdomain deployments require a shared SESSION_DOMAIN.
